# =============================================================================
# Text normalization
# =============================================================================
#
# The repository is developed from both Linux and macOS systems.
#
# All text files are stored in Git with LF line endings regardless of the
# platform from which they are committed.

* text=auto eol=lf


# =============================================================================
# Explicit text formats
# =============================================================================

*.sh       text eol=lf
*.fish     text eol=lf
*.conf     text eol=lf
*.rasi     text eol=lf
*.toml     text eol=lf
*.ini      text eol=lf
*.json     text eol=lf
*.jsonc    text eol=lf
*.md       text eol=lf
*.txt      text eol=lf
*.yml      text eol=lf
*.yaml     text eol=lf
*.desktop  text eol=lf
*.service  text eol=lf


# =============================================================================
# Binary files
# =============================================================================

*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.gif   binary
*.ico   binary
