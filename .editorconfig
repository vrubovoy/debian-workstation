# ******************************************************************************
# @file    .editorconfig
# @author  Vrubovoy (github.com/vrubovoy)
# @brief   Formatting: UTF-8, LF, final newline, 4-space indents (2 in YAML).
# ******************************************************************************
# Copyright (c) 2026 Vrubovoy. MIT License, see LICENSE.
# ******************************************************************************

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2
