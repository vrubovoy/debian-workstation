# =============================================================================
# EditorConfig
# =============================================================================
#
# Formatting for every file in this repository: UTF-8, LF, a final newline,
# 4-space indents (2 in YAML) and no trailing whitespace. Neovim applies it
# natively.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true

[*.{yml,yaml}]
indent_size = 2
