# ******************************************************************************
# @file    90-workstation-wakeup.rules
# @author  Vrubovoy (github.com/vrubovoy)
# @brief   The PCIe port of a graphics card may not wake the system.
# @path    /etc/udev/rules.d/90-workstation-wakeup.rules
# @apply   reboot
# ******************************************************************************
# Copyright (c) 2026 Vrubovoy. MIT License, see LICENSE.
# ******************************************************************************

ACTION=="add", SUBSYSTEM=="pci", ATTR{class}=="0x03*", RUN+="/bin/sh -c 'port=/sys%p/../power/wakeup; [ -w $$port ] && echo disabled > $$port || true'"
