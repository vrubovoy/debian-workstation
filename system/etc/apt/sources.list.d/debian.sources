# ******************************************************************************
# @file    debian.sources
# @author  Vrubovoy (github.com/vrubovoy)
# @brief   Debian 13 sources with contrib and non-free.
# @path    /etc/apt/sources.list.d/debian.sources
# @apply   sudo apt update
