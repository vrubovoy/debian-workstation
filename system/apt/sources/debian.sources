# =============================================================================
# Debian 13 (trixie) repositories
# =============================================================================
#
# The workstation needs packages from main as well as selected packages from
# contrib/non-free (for example the Ubuntu font family).
#
# Debian 13 uses the deb822 .sources format as the preferred configuration.
# =============================================================================

Types: deb
URIs: https://deb.debian.org/debian
Suites: trixie trixie-updates
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg

Types: deb
URIs: https://security.debian.org/debian-security
Suites: trixie-security
Components: main contrib non-free non-free-firmware
Signed-By: /usr/share/keyrings/debian-archive-keyring.gpg
