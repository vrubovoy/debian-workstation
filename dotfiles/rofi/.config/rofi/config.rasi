/*******************************************************************************
 * @file    config.rasi
 * @author  Vrubovoy (github.com/vrubovoy)
 * @brief   Rofi launcher and the menus of the workstation-* commands.
 * @path    ~/.config/rofi/config.rasi
 *******************************************************************************
 * Copyright (c) 2026 Vrubovoy. MIT License, see LICENSE.
 ******************************************************************************/

configuration {
    modes: [ drun, run, window ];

    show-icons: true;
    icon-theme: "Adwaita";

    /* Show only the name, but still match generic names, categories and
     * keywords: "browser" finds Firefox. */
    drun-display-format: "{name}";
    drun-match-fields: "name,generic,exec,categories,keywords";
    drun-show-actions: false;

    matching: "fuzzy";
    sort: true;
    sorting-method: "fzf";
    case-smart: true;
    tokenize: true;
    cycle: true;

    terminal: "kitty";

    /* -4: the monitor with the focused window, not the one under the mouse. */
    monitor: -4;
    steal-focus: true;
    click-to-exit: true;

    drun {
        display-name: "Apps";
    }

    run {
        display-name: "Run";
    }

    window {
        display-name: "Windows";
    }

    entry {
        max-history: 30;
    }
}

@theme "graphite-blue"
