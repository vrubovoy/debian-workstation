/* =============================================================================
 * Graphite Blue — Rofi theme
 * =============================================================================
 *
 * Used by the launcher and every Rofi menu.
 *
 * Path:  ~/.config/rofi/graphite-blue.rasi
 */

* {
    bg:             #111318;
    surface:        #1A1D24;
    surface-alt:    #222630;
    border:         #303744;

    fg:             #E6E9EF;
    muted:          #8E98A8;

    accent:         #7AA2F7;
    accent-hover:   #89B4FA;
    ring:           rgba(122, 162, 247, 0.18);

    urgent:         #E06C75;

    background-color: transparent;
    text-color: @fg;

    font: "Ubuntu Bold 16";
}


/* =============================================================================
 * Main window
 * ============================================================================= */

/* The faint outer ring and the accent border inside it look like a focused
 * text field: Rofi has the keyboard while it is open. */
window {
    width: 42%;

    location: center;
    anchor: center;

    background-color: transparent;

    border: 1px;
    border-color: @ring;
    border-radius: 17px;

    /* Real ARGB window (Picom), not a screenshot-based fake. */
    transparency: "real";
}


/* =============================================================================
 * Main container
 * ============================================================================= */

mainbox {
    background-color: @bg;

    border: 2px;
    border-color: @accent;
    border-radius: 16px;

    padding: 18px;
    spacing: 14px;

    children: [
        inputbar,
        listview,
        message
    ];
}


/* =============================================================================
 * Search field
 * ============================================================================= */

inputbar {
    background-color: @surface;

    border: 1px;
    border-color: @border;
    border-radius: 11px;

    padding: 12px 14px;

    spacing: 10px;

    children: [
        prompt,
        entry
    ];
}


prompt {
    background-color: transparent;
    text-color: @accent;

    padding: 0px;

    vertical-align: 0.5;
}


entry {
    background-color: transparent;
    text-color: @fg;

    placeholder: "Search…";
    placeholder-color: @muted;

    cursor: text;

    vertical-align: 0.5;
}


/* =============================================================================
 * Result list
 * ============================================================================= */

listview {
    background-color: transparent;

    lines: 8;

    columns: 1;

    fixed-height: false;

    dynamic: true;

    cycle: true;

    scrollbar: false;

    spacing: 5px;
}


/* =============================================================================
 * Result entries
 * ============================================================================= */

element {
    background-color: transparent;
    text-color: @fg;

    border: 0px;
    border-radius: 10px;

    padding: 9px 11px;

    spacing: 12px;

    orientation: horizontal;

    cursor: pointer;
}


element normal.normal {
    background-color: transparent;
    text-color: @fg;
}


element alternate.normal {
    background-color: transparent;
    text-color: @fg;
}


element selected.normal {
    background-color: @accent;
    text-color: @bg;
}


element normal.active,
element alternate.active {
    background-color: @surface-alt;
    text-color: @accent;
}


element selected.active {
    background-color: @accent;
    text-color: @bg;
}


element normal.urgent,
element alternate.urgent {
    background-color: transparent;
    text-color: @urgent;
}


element selected.urgent {
    background-color: @urgent;
    text-color: @bg;
}


/* =============================================================================
 * Application icons
 * ============================================================================= */

element-icon {
    background-color: transparent;

    size: 34px;

    vertical-align: 0.5;
}


/* =============================================================================
 * Result text
 * ============================================================================= */

element-text {
    background-color: transparent;
    text-color: inherit;

    vertical-align: 0.5;

    /* Bold only: an inherited color keeps selected rows readable. */
    highlight: bold;
}


/* =============================================================================
 * Error / informational messages
 * ============================================================================= */

message {
    background-color: @surface;

    border: 1px;
    border-color: @border;
    border-radius: 10px;

    padding: 10px;
}


textbox {
    background-color: transparent;
    text-color: @muted;
}


/* =============================================================================
 * Scrollbar (hidden in the listview, styled for menus that enable it)
 * ============================================================================= */

scrollbar {
    width: 4px;

    border: 0px;
    border-radius: 2px;

    background-color: @surface-alt;

    handle-color: @accent;
}


/* =============================================================================
 * Mode switcher (hidden; modes still switch from the keyboard)
 * ============================================================================= */

mode-switcher {
    enabled: false;
}
