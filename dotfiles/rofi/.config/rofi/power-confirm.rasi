/*******************************************************************************
 * @file    power-confirm.rasi
 * @author  Vrubovoy (github.com/vrubovoy)
 * @brief   Power menu confirmation; the action goes ahead after five seconds.
 * @path    ~/.config/rofi/power-confirm.rasi
 *******************************************************************************
 * Copyright (c) 2026 Vrubovoy. MIT License, see LICENSE.
 ******************************************************************************/

@import "power-menu"

configuration {
    timeout {
        delay: 5;
        action: "kb-accept-entry";
    }
}

window {
    padding: calc( 50% - 151px ) calc( 50% - 221px );
}

inputbar {
    orientation: vertical;
    spacing: 4px;
}

prompt {
    text-color: @fg;
}

textbox-hint {
    horizontal-align: 0.0;

    content: "Enter now · Esc to cancel";
}

listview {
    columns: 2;
}
