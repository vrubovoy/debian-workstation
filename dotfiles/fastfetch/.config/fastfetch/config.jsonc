{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    // =========================================================================
    // Logo
    // =========================================================================
    //
    // The old CachyOS configuration used the distribution logo with a height
    // of 20 rows.
    //
    // Kitty can display a real raster image directly in the terminal, so the
    // Debian workstation keeps the same approximate logo size while replacing
    // the distribution logo with a custom image.
    //
    // Supported formats include PNG, JPEG, WebP and others supported by the
    // Fastfetch build.

    "logo": {
        "type": "kitty",
        "source": "~/.config/fastfetch/logo.png",
        "height": 20
    },


    // =========================================================================
    // Display
    // =========================================================================

    "display": {
        "separator": " : "
    },


    // =========================================================================
    // Modules
    // =========================================================================

    "modules": [

        // ---------------------------------------------------------------------
        // System
        // ---------------------------------------------------------------------

        {
            "type": "custom",
            "format": "\u001b[36m    コンピューター"
        },

        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────┐"
        },

        {
            "type": "os",
            "key": "  󰣇 OS",
            "format": "{2}",
            "keyColor": "red"
        },

        {
            "type": "kernel",
            "key": "   Kernel",
            "format": "{2}",
            "keyColor": "red"
        },

        {
            "type": "packages",
            "key": "  󰏗 Packages",
            "keyColor": "green"
        },

        {
            "type": "display",
            "key": "  󰍹 Display",
            "format": "{1}x{2} @ {3}Hz [{7}]",
            "keyColor": "green"
        },

        {
            "type": "terminal",
            "key": "   Terminal",
            "keyColor": "yellow"
        },

        {
            "type": "wm",
            "key": "  󱗃 WM",
            "format": "{2}",
            "keyColor": "yellow"
        },

        {
            "type": "custom",
            "format": "└──────────────────────────────────────────┘"
        },


        "break",


        // ---------------------------------------------------------------------
        // User / hardware
        // ---------------------------------------------------------------------

        {
            "type": "title",
            "key": "ユーザー"
        },

        {
            "type": "custom",
            "format": "┌──────────────────────────────────────────┐"
        },

        {
            "type": "cpu",
            "key": "   CPU",
            "format": "{1} @ {7}",
            "keyColor": "blue"
        },

        {
            "type": "gpu",
            "key": "  󰊴 GPU",
            "format": "{1} {2}",
            "keyColor": "blue"
        },

        {
            "type": "gpu",
            "key": "   GPU Driver",
            "format": "{3}",
            "keyColor": "magenta"
        },

        {
            "type": "memory",
            "key": "   Memory ",
            "keyColor": "magenta"
        },

        {
            "type": "disk",
            "key": "  󱦟 OS Age ",
            "folders": "/",
            "format": "{days} days",
            "keyColor": "red"
        },

        {
            "type": "uptime",
            "key": "  󱫐 Uptime ",
            "keyColor": "red"
        },

        {
            "type": "custom",
            "format": "└──────────────────────────────────────────┘"
        },


        // ---------------------------------------------------------------------
        // Terminal palette
        // ---------------------------------------------------------------------

        {
            "type": "colors",
            "paddingLeft": 2,
            "symbol": "circle"
        },


        "break"
    ]
}