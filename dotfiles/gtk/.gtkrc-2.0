# ******************************************************************************
# @file    .gtkrc-2.0
# @author  Vrubovoy (github.com/vrubovoy)
# @brief   GTK 2, used only by pinentry-gtk2: the same dark theme as GTK 3.
# @path    ~/.gtkrc-2.0
# ******************************************************************************
