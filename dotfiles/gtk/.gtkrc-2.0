# =============================================================================
# GTK 2 — settings
# =============================================================================
#
# Only pinentry-gtk2 uses GTK 2; it gets the same dark theme as GTK 3.
#
# Path:  ~/.gtkrc-2.0

gtk-theme-name = "Adwaita-dark"
gtk-icon-theme-name = "Adwaita"
gtk-font-name = "Ubuntu Bold 13"
gtk-cursor-theme-name = "Adwaita"
gtk-cursor-theme-size = 24
