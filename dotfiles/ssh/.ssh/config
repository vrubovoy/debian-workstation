# =============================================================================
# OpenSSH — client
# =============================================================================
#
# Keys and known_hosts are never tracked. For each option the first matching
# value wins, so specific hosts come before `Host *`.
#
# Path:  ~/.ssh/config

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    # Offer only this key, not every key loaded in the agent.
    IdentitiesOnly yes

Host *
    # The agent is started by Debian's Xsession for the whole X session.
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
