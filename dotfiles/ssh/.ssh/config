# =============================================================================
# OpenSSH client configuration
# =============================================================================
#
# Reproducible workstation SSH client behaviour.
#
# Private keys and host fingerprints are deliberately not tracked by the
# workstation repository.
#
# =============================================================================


# =============================================================================
# Global defaults
# =============================================================================

Host *

    # Add successfully used keys to the session-wide ssh-agent started by the
    # Debian X11 session.
    AddKeysToAgent yes

    # Keep long-lived interactive connections alive across temporary network
    # interruptions.
    ServerAliveInterval 60
    ServerAliveCountMax 3


# =============================================================================
# GitHub
# =============================================================================

Host github.com
    HostName github.com
    User git

    # Workstation GitHub identity.
    IdentityFile ~/.ssh/id_ed25519

    # For this host use only explicitly configured identities instead of
    # offering every key currently loaded into ssh-agent.
    IdentitiesOnly yes