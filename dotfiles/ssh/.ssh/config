# =============================================================================
# OpenSSH client configuration
# =============================================================================
#
# Reproducible client behaviour.
#
# Private keys and host fingerprints are deliberately not tracked.
#
# =============================================================================


# =============================================================================
# Global defaults
# =============================================================================

Host *

    # Add successfully used private keys to the session ssh-agent.
    AddKeysToAgent yes

    # Prefer modern Ed25519 workstation identity when available.
    IdentityFile ~/.ssh/id_ed25519

    # Prevent SSH from trying every key that happens to be loaded into the
    # agent before the configured identity.
    IdentitiesOnly yes

    # Keep long-lived interactive connections healthy across temporary network
    # stalls.
    ServerAliveInterval 60
    ServerAliveCountMax 3

    # Reuse existing authenticated TCP connections.
    #
    # This noticeably speeds up repeated Git/SSH operations.
    ControlMaster auto
    ControlPersist 10m
    ControlPath ~/.ssh/control-%C

    # Compression is normally unnecessary on modern networks and can waste CPU.
    Compression no


# =============================================================================
# GitHub
# =============================================================================

Host github.com
    HostName github.com
    User git

    IdentityFile ~/.ssh/id_ed25519

    IdentitiesOnly yes