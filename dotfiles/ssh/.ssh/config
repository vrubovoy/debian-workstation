# ******************************************************************************
# @file    config
# @author  Vrubovoy (github.com/vrubovoy)
# @brief   OpenSSH client; keys and known_hosts are never tracked.
# @path    ~/.ssh/config
# ******************************************************************************
# Copyright (c) 2026 Vrubovoy. MIT License, see LICENSE.
# ******************************************************************************

Host github.com
    HostName github.com
    User git
    IdentityFile ~/.ssh/id_ed25519
    # Offer only this key, not every key loaded in the agent.
    IdentitiesOnly yes

# Defaults go last: for each option the first match wins.
Host *
    # The agent is started by Debian's Xsession for the whole X session.
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
