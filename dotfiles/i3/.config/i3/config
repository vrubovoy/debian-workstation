# i3 — Graphite Blue.
#
# Modifier: Super. Keyboard layouts (US/RU, Alt+Space, Compose on Right Alt)
# come from /etc/default/keyboard. workstation-* commands live in
# scripts/session/ and are linked into ~/.local/bin by the installer.


# =============================================================================
# Core
# =============================================================================

set $mod Mod4
set $terminal kitty

font pango:Ubuntu Bold 15

set $bg       #111318
set $surface  #1A1D24
set $border   #303744
set $fg       #E6E9EF
set $muted    #8E98A8
set $accent   #7AA2F7
set $urgent   #E06C75


# =============================================================================
# Windows
# =============================================================================

# Thin borders instead of title bars; tabbed/stacked layouts keep their titles.
default_border pixel 2
default_floating_border pixel 2
hide_edge_borders none
title_align center

# Screen edge distance is outer + inner: 15 px.
gaps inner 10px
gaps outer 5px
smart_gaps off

# class                     border     background  text      indicator  child_border
client.focused              $accent    $surface    $fg       $accent    $accent
client.focused_inactive     $border    $surface    $muted    $border    $border
client.unfocused            $border    $bg         $muted    $border    $border
client.urgent               $urgent    $urgent     $bg       $urgent    $urgent
client.placeholder          $border    $bg         $fg       $border    $border
client.background           $bg

focus_follows_mouse yes
mouse_warping none
focus_wrapping yes

# Super+Tab returns to the previous workspace; pressing the current
# workspace's key does nothing.
workspace_auto_back_and_forth no

popup_during_fullscreen smart

# A window asking for focus on another workspace is marked urgent instead.
focus_on_window_activation smart

# Super + left/right drag moves/resizes floating windows; tiled windows are
# dragged only while Super is held (add Shift to swap).
floating_modifier $mod
tiling_drag modifier


# =============================================================================
# Applications
# =============================================================================

bindsym $mod+Return exec $terminal
bindsym $mod+w exec --no-startup-id firefox
bindsym $mod+c exec --no-startup-id codium
bindsym $mod+e exec --no-startup-id thunar

bindsym $mod+space exec --no-startup-id rofi -show drun
bindsym $mod+Control+Return exec --no-startup-id rofi -show drun

# Clipboard history; the chosen item is restored for Ctrl+V.
bindsym $mod+v exec --no-startup-id workstation-clipboard


# =============================================================================
# Window management
# =============================================================================

bindsym $mod+q kill

bindsym $mod+f fullscreen toggle
bindsym Mod1+Return fullscreen toggle

bindsym $mod+t floating toggle
bindsym $mod+Shift+w layout toggle split tabbed

# Focus: arrows or H/J/K. Super+L is the lock screen, so right is arrow-only.
bindsym $mod+Left  focus left
bindsym $mod+h     focus left
bindsym $mod+Right focus right
bindsym $mod+Up    focus up
bindsym $mod+k     focus up
bindsym $mod+Down  focus down
bindsym $mod+j     focus down

# Move: Ctrl added to the focus keys.
bindsym $mod+Control+Left  move left
bindsym $mod+Control+h     move left
bindsym $mod+Control+Right move right
bindsym $mod+Control+l     move right
bindsym $mod+Control+Up    move up
bindsym $mod+Control+k     move up
bindsym $mod+Control+Down  move down
bindsym $mod+Control+j     move down

# Monitors: Shift focuses, Shift+Ctrl moves the window.
bindsym $mod+Shift+Left  focus output left
bindsym $mod+Shift+Right focus output right
bindsym $mod+Shift+Up    focus output up
bindsym $mod+Shift+Down  focus output down

bindsym $mod+Shift+Control+Left  move container to output left
bindsym $mod+Shift+Control+Right move container to output right
bindsym $mod+Shift+Control+Up    move container to output up
bindsym $mod+Shift+Control+Down  move container to output down

# Resize: 10% for tiled windows, 10 px for floating ones.
bindsym $mod+minus       resize shrink width 10 px or 10 ppt
bindsym $mod+equal       resize grow width 10 px or 10 ppt
bindsym $mod+Shift+minus resize shrink height 10 px or 10 ppt
bindsym $mod+Shift+equal resize grow height 10 px or 10 ppt


# =============================================================================
# Workspaces
# =============================================================================

set $ws1  1
set $ws2  2
set $ws3  3
set $ws4  4
set $ws5  5
set $ws6  6
set $ws7  7
set $ws8  8
set $ws9  9
set $ws10 10

bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

bindsym $mod+Mod1+1 move container to workspace number $ws1
bindsym $mod+Mod1+2 move container to workspace number $ws2
bindsym $mod+Mod1+3 move container to workspace number $ws3
bindsym $mod+Mod1+4 move container to workspace number $ws4
bindsym $mod+Mod1+5 move container to workspace number $ws5
bindsym $mod+Mod1+6 move container to workspace number $ws6
bindsym $mod+Mod1+7 move container to workspace number $ws7
bindsym $mod+Mod1+8 move container to workspace number $ws8
bindsym $mod+Mod1+9 move container to workspace number $ws9
bindsym $mod+Mod1+0 move container to workspace number $ws10

bindsym $mod+Tab workspace back_and_forth

# Super + wheel switches workspaces, Super+Ctrl + wheel takes the window
# along; --whole-window makes it work over application windows.
bindsym --whole-window $mod+button4 workspace prev
bindsym --whole-window $mod+button5 workspace next
bindsym --whole-window $mod+Control+button4 move container to workspace prev
bindsym --whole-window $mod+Control+button5 move container to workspace next


# =============================================================================
# Session and hardware keys
# =============================================================================

bindsym $mod+l exec --no-startup-id workstation-lock
bindsym $mod+BackSpace exec --no-startup-id workstation-power-menu
bindsym Control+Mod1+Delete exec --no-startup-id workstation-power-menu

# Screenshots go to ~/Pictures/Screenshots and the clipboard.
bindsym $mod+p      exec --no-startup-id workstation-screenshot area
bindsym Print       exec --no-startup-id workstation-screenshot screen
bindsym Shift+Print exec --no-startup-id workstation-screenshot area
bindsym Mod1+Print  exec --no-startup-id workstation-screenshot window

bindsym XF86AudioRaiseVolume exec --no-startup-id workstation-volume up
bindsym XF86AudioLowerVolume exec --no-startup-id workstation-volume down
bindsym XF86AudioMute        exec --no-startup-id workstation-volume mute
bindsym XF86AudioMicMute     exec --no-startup-id workstation-volume mic-mute

# playerctld (started below) sends these to the most recently active player.
bindsym XF86AudioNext  exec --no-startup-id playerctl --no-messages next
bindsym XF86AudioPrev  exec --no-startup-id playerctl --no-messages previous
bindsym XF86AudioPlay  exec --no-startup-id playerctl --no-messages play-pause
bindsym XF86AudioPause exec --no-startup-id playerctl --no-messages play-pause

bindsym XF86MonBrightnessUp   exec --no-startup-id workstation-brightness up
bindsym XF86MonBrightnessDown exec --no-startup-id workstation-brightness down

# Displays off now; any input wakes them.
bindsym $mod+Shift+p exec --no-startup-id xset dpms force off

bindsym $mod+Control+r reload
bindsym $mod+Shift+r restart


# =============================================================================
# Autostart
# =============================================================================

exec --no-startup-id workstation-wallpaper

# Idle: lock after 10 minutes, displays off after 15.
exec --no-startup-id xset s 600 0 +dpms dpms 0 0 900

# xss-lock runs the locker on idle and before suspend; --transfer-sleep-lock
# holds the suspend until the screen is actually locked.
exec --no-startup-id xss-lock --transfer-sleep-lock -- workstation-lock

exec --no-startup-id /usr/libexec/polkit-mate-authentication-agent-1
exec --no-startup-id nm-applet
exec --no-startup-id blueman-applet
exec --no-startup-id picom
exec --no-startup-id playerctld daemon
exec --no-startup-id workstation-clipboard start
exec --no-startup-id dunst


# =============================================================================
# Bar
# =============================================================================

bar {
    position bottom
    mode dock
    status_command i3status
    font pango:Ubuntu Bold 15

    # Space between the screen edges and the workspace buttons / tray.
    padding 0 16px

    # No tray_output: i3bar then uses the first active output. With
    # "primary" and no primary output set (common in VMs) the tray vanishes.
    tray_padding 4

    workspace_min_width 44
    separator_symbol "│"

    colors {
        background         $bg
        statusline         $fg
        separator          $border

        #                     border    background  text
        focused_workspace     $accent   $accent     $bg
        active_workspace      $border   $surface    $fg
        inactive_workspace    $bg       $bg         $muted
        urgent_workspace      $urgent   $urgent     $bg
        binding_mode          $accent   $accent     $bg
    }
}
