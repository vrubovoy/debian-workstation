# Dunst — Graphite Blue. Also draws the volume, brightness and screenshot OSD
# sent by scripts/session (stack tags make repeated OSDs replace each other).

[global]

# Placement: the monitor with the keyboard-focused window, top right.
follow = keyboard
monitor = 0
origin = top-right
offset = (16, 16)
scale = 0

# Geometry: width and height as (min, max).
width = (360, 460)
height = (0, 300)
notification_limit = 6
indicate_hidden = true

padding = 14
horizontal_padding = 16
text_icon_padding = 14
gap_size = 8
separator_height = 0

frame_width = 2
corner_radius = 14
corners = all
icon_corner_radius = 10
icon_corners = all
transparency = 0

# Text
font = Ubuntu Bold 15
line_height = 4
format = "<b>%s</b>\n%b"
markup = full
alignment = left
vertical_alignment = center
ignore_newline = false
word_wrap = true
ellipsize = end

# Icons
icon_theme = Adwaita
enable_recursive_icon_lookup = true
icon_position = left
min_icon_size = 48
max_icon_size = 64

# Progress bar, shown for notifications with an int:value hint.
progress_bar = true
progress_bar_height = 8
progress_bar_min_width = 180
progress_bar_max_width = 360
progress_bar_frame_width = 0
progress_bar_corner_radius = 4
progress_bar_corners = all
progress_bar_horizontal_alignment = left

# Behaviour
sort = urgency_descending
stack_duplicates = true
hide_duplicate_count = false
fullscreen = delay
show_age_threshold = 60
history_length = 50
sticky_history = true
ignore_dbusclose = false
enable_posix_regex = true
force_xinerama = false

# Actions and links: left click runs the default action, middle click
# dismisses, right click opens the action menu in Rofi.
dmenu = rofi -dmenu -p "Notification"
browser = /usr/bin/xdg-open
show_indicators = true
mouse_left_click = do_action, close_current
mouse_middle_click = close_current
mouse_right_click = context

[urgency_low]
background = "#111318"
foreground = "#8E98A8"
frame_color = "#303744"
highlight = "#7AA2F7"
timeout = 4s

[urgency_normal]
background = "#1A1D24"
foreground = "#E6E9EF"
frame_color = "#7AA2F7"
highlight = "#7AA2F7"
timeout = 6s

# Critical notifications stay until dismissed.
[urgency_critical]
background = "#1A1D24"
foreground = "#E6E9EF"
frame_color = "#E06C75"
highlight = "#E06C75"
timeout = 0
