# ******************************************************************************
# @file    .xsessionrc
# @author  Vrubovoy (github.com/vrubovoy)
# @brief   X session environment, read before i3 starts.
# @path    ~/.xsessionrc
# @apply   log out and back in
# ******************************************************************************
# Copyright (c) 2026 Vrubovoy. MIT License, see LICENSE.
# ******************************************************************************

# workstation-* helpers used by i3.
PATH="$HOME/.local/bin:$PATH"
export PATH

# Qt 5 and Qt 6 follow the GTK theme, fonts and dialogs.
export QT_QPA_PLATFORMTHEME=gtk3

# A writable bytecode cache: Debian ships no .opt-2.pyc files, so Kitty would
# compile its Python modules on every start.
export PYTHONPYCACHEPREFIX="$HOME/.cache/python"
