# =============================================================================
# X session environment
# =============================================================================
#
# Sourced by Debian's Xsession before i3 starts, so it also reaches programs
# launched from i3 and Rofi.
#
# Path:  ~/.xsessionrc
# Apply: log out and back in

# workstation-* helpers used by i3.
PATH="$HOME/.local/bin:$PATH"
export PATH

# Qt 5 and Qt 6 follow the GTK theme, fonts and dialogs.
export QT_QPA_PLATFORMTHEME=gtk3
