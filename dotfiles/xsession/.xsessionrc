# =============================================================================
# X11 session environment
# =============================================================================
#
# Environment shared by applications started directly from the graphical
# session (i3, Rofi, desktop launchers, etc.).
#
# This must NOT live only in Fish because GUI applications do not necessarily
# start from an interactive shell.
#
# =============================================================================


# =============================================================================
# Qt desktop integration
# =============================================================================
#
# Make both Qt 5 and Qt 6 applications use their GTK 3 platform-theme plugin.
#
# This provides:
#
#   - GTK-derived fonts;
#   - GTK-derived colors;
#   - Adwaita icons;
#   - GTK-style native dialogs;
#   - consistent appearance without KDE or a full desktop environment.

export QT_QPA_PLATFORMTHEME=gtk3