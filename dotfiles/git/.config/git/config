# =============================================================================
# Git
# =============================================================================
#
# Behaviour shared by every machine. Name, email and the signing key are
# machine-local in ~/.gitconfig.local (scripts/configure/git.sh).
#
# Path:  ~/.config/git/config

[include]
    path = ~/.gitconfig.local

[init]
    defaultBranch = main

[core]
    editor = nvim
    pager = less -FRX

[color]
    ui = auto

[fetch]
    prune = true

[push]
    autoSetupRemote = true

# Diverged branches need an explicit rebase or merge, never a silent merge commit.
[pull]
    ff = only

[rebase]
    autoStash = true
    updateRefs = true

[diff]
    algorithm = histogram
    colorMoved = default

# zdiff3 also shows the common ancestor in conflicts.
[merge]
    conflictStyle = zdiff3

# Reuse recorded conflict resolutions, e.g. across repeated rebases.
[rerere]
    enabled = true
    autoUpdate = true

[tag]
    sort = version:refname

[branch]
    sort = -committerdate

[help]
    autocorrect = prompt

[apply]
    whitespace = fix

[alias]
    st = status --short --branch
    graph = log --graph --decorate --oneline --all
    last = log -1 --stat
