# i3status — the right side of i3bar. The bar's font and colors are set in
# ~/.config/i3/config. Missing hardware (Wi-Fi, Ethernet, battery) hides its
# block, so the same file works on laptops and desktops.

general {
    output_format = "i3bar"
    colors = true
    interval = 2

    # Normal values use the bar's text color; only these states are colored.
    color_good = "#7AA2F7"
    color_degraded = "#E5C07B"
    color_bad = "#E06C75"
}

order += "cpu_usage"
order += "memory"
order += "disk /"
order += "volume master"
order += "wireless _first_"
order += "ethernet _first_"
order += "battery all"
order += "tztime local"

# min_width keeps each block from shifting the bar as values change.

cpu_usage {
    format = "CPU %usage"
    min_width = "CPU 100%"
    degraded_threshold = 70
    max_threshold = 90
    format_above_degraded_threshold = "CPU %usage"
    format_above_threshold = "CPU %usage"
}

# Used memory as `free` counts it (reclaimable cache is not "used"). The
# thresholds refer to *available* memory.
memory {
    format = "RAM %percentage_used"
    format_degraded = "RAM %percentage_used"
    memory_used_method = "memavailable"
    threshold_degraded = "20%"
    threshold_critical = "10%"
    min_width = "RAM 100%"
}

# /home is on the root filesystem, so this is the free space for everything.
disk "/" {
    format = "SSD %avail"
    format_below_threshold = "SSD %avail"
    prefix_type = "binary"
    low_threshold = 10
    threshold_type = "percentage_avail"
    min_width = "SSD 999.9 GiB"
}

# pipewire-pulse provides the PulseAudio API i3status reads.
volume master {
    format = "VOL %volume"
    format_muted = "VOL muted"
    device = "pulse"
    min_width = "VOL muted"
}

wireless _first_ {
    format_up = "Wi-Fi %essid %quality"
    format_down = ""
    format_quality = "%d%s"
}

ethernet _first_ {
    format_up = "LAN %ip"
    format_down = ""
}

battery all {
    format = "%status %percentage %remaining"
    format_down = ""
    status_chr = "AC"
    status_bat = "BAT"
    status_unk = "BAT"
    status_full = "AC"
    status_idle = "AC"
    low_threshold = 15
    threshold_type = "percentage"
    hide_seconds = true
    format_percentage = "%.0f%s"
}

tztime local {
    format = "%d.%m.%Y  %H:%M"
    min_width = "00.00.0000  00:00"
}

# CPU temperature needs a machine-specific sensor path, so it is left out.
# To add it on one machine, find the sensor with
# `find /sys/class/hwmon -name 'temp*_input'` and add:
#
#   order += "cpu_temperature 0"
#
#   cpu_temperature 0 {
#       format = "TEMP %degrees°C"
#       max_threshold = 85
#       path = "/sys/class/hwmon/hwmonX/tempY_input"
#   }
